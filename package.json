{
  "name": "little-relay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "config:generate": "node scripts/generate-config.mjs",
    "dev:public": "wrangler dev --config .generated/public.wrangler.jsonc --env test",
    "dev:owner": "wrangler dev --config .generated/owner.wrangler.jsonc --env test",
    "lint": "biome check src scripts tests config package.json tsconfig.json biome.json",
    "format": "biome format --write src scripts tests config package.json tsconfig.json biome.json",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/generate-config.mjs config/store.example.json .test-generated",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261005.1",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  }
}
